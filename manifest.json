{
  "manifest_version": 3,
  "name": "Apply Copilot",
  "version": "1.0.0",
  "description": "Reads a job posting, scores it against your resume, and fills the application form. You press Submit.",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Apply Copilot" },
  "side_panel": { "default_path": "sidepanel/panel.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/parser.js", "content/filler.js", "content/main.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": { "128": "icons/icon128.png" }
}
